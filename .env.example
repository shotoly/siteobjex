# Configuration Notion API pour Objex3D
# Clé secrète d'intégration Notion (interne au build Node.js, jamais exposée au client)
NOTION_API_KEY=secret_notion_api_key_here

# ID de la page ou base Notion parente pour les projets personnels / portfolio
NOTION_DB_PERSONNEL=39c0bf864fef43c2bc80cc9f14f18707

# Nouveaux identifiants de bases de données pour les Services
# 1. Base des Réalisations / Projets Clients
NOTION_CLIENT_PROJECTS_DB_ID=client_projects_database_id_here

# 2. Base des Filaments en stock
NOTION_FILAMENTS_DB_ID=filaments_database_id_here

# 3. Base des Modèles 3D / Impressions en Vedette (Scraper MakerWorld)
NOTION_PRINTS_DB_ID=featured_prints_database_id_here
